# ==============================================
# BlackBox AI - Environment Configuration Example
# Copy this file to .env and add your actual API key
# ==============================================

# OpenRouter API Key for Gemma Meeting Intelligence
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Faster-Whisper Model Configuration (base, small, medium)
WHISPER_MODEL=base

# Backend Server Settings
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
